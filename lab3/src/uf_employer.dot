digraph uf_employer {
  graph [rankdir=TB, fontname="Arial", fontsize=12, nodesep=0.35, ranksep=0.4, pad=0.35, newrank=true, compound=true];
  node [fontname="Arial", fontsize=11, style=filled, fillcolor=white, color=black, penwidth=1.2];
  edge [fontname="Arial", fontsize=9.5, color="#222222", arrowsize=0.8];
  st [shape=ellipse, fillcolor="#dddddd", penwidth=1.4, fontsize=11, label="Ціль: закрити вакансії компанії\nкандидатами (після входу, рис. 1)"];
  subgraph cluster_t1 {
    label="Завдання: підтримувати профіль компанії (E1)"; labeljust=l; style="dashed,rounded"; color="#777777"; fontsize=11; fontname="Arial Bold"; margin=10;
    comp [shape=box, margin="0.08,0.04", class="page", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Моя компанія</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">/company</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">• назва, місто, адреса, контакти, опис<BR/>• «Редагувати»</FONT></TD></TR></TABLE>>];
    compEdit [shape=box, margin="0.08,0.04", class="page", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Редагування моєї компанії</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">/company/edit</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">• назва, місто, адреса, телефон,<BR/>• email, сайт, опис</FONT></TD></TR></TABLE>>];
    dv1 [shape=diamond, fillcolor="#e9e9e9", fontsize=10, margin="0.02,0.02", label="Дані коректні,\nназва унікальна?"];
  }
  subgraph cluster_t2 {
    label="Завдання: вести вакансії компанії (E2)"; labeljust=l; style="dashed,rounded"; color="#777777"; fontsize=11; fontname="Arial Bold"; margin=10;
    cvac [shape=box, margin="0.08,0.04", class="page", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Вакансії компанії</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">/company/vacancies</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">• посада, зарплата, місто, статус, кандидатури<BR/>• «Додати», «Редагувати»<BR/>• «Закрити» / «Відкрити», «Видалити»<BR/>• «Відповідні резюме», «Кандидатури»</FONT></TD></TR></TABLE>>];
    vForm [shape=box, margin="0.08,0.04", class="group", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Нова вакансія · Редагування вакансії</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">/company/vacancies/new, …/{id}/edit</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">• посада, зарплата, мін. освіта,<BR/>• мін. досвід, місто, вимоги</FONT></TD></TR></TABLE>>];
    dv2 [shape=diamond, fillcolor="#e9e9e9", fontsize=10, margin="0.02,0.02", label="Дані\nкоректні?"];
    dDel [shape=diamond, fillcolor="#e9e9e9", fontsize=10, margin="0.02,0.02", label="Підтвердити\nвидалення?"];
    e2 [shape=ellipse, fillcolor="#dddddd", penwidth=2.6, fontsize=11, label="Результат:\nвакансії актуальні"];
  }
  subgraph cluster_t3 {
    label="Завдання: знайти й відібрати кандидатів (E3, E4)"; labeljust=l; style="dashed,rounded"; color="#777777"; fontsize=11; fontname="Arial Bold"; margin=10;
    m1 [shape=box, class="process", margin="0.22,0.06", fillcolor="#f2f2f2", label="Оцінювання відповідності (M1)"];
    dm [shape=diamond, fillcolor="#e9e9e9", fontsize=10, margin="0.02,0.02", label="Є резюме\n≥ 50 %?"];
    mat [shape=box, margin="0.08,0.04", class="page", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Відповідні резюме</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">/company/vacancies/{id}/matches</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">• ім'я, перша літера прізвища, посада,<BR/>• зарплата, освіта, стаж, оцінка, складові<BR/>• «Мін. оцінка, %», «Оновити»</FONT></TD></TR></TABLE>>];
    e3a [shape=ellipse, fillcolor="#dddddd", penwidth=2.6, fontsize=11, label="Результат: знайдено\nрелевантні резюме"];
    apps [shape=box, margin="0.08,0.04", class="page", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Кандидатури на вакансію</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">/company/vacancies/{id}/applications</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">• ПІБ, джерело, коментар рекрутера,<BR/>• дата, статус<BR/>• «Запросити», «Відхилити»</FONT></TD></TR></TABLE>>];
    dec [shape=diamond, fillcolor="#e9e9e9", fontsize=10, margin="0.02,0.02", label="Рішення?"];
    e3 [shape=ellipse, fillcolor="#dddddd", penwidth=2.6, fontsize=11, label="Результат:\nкандидатури розглянуто"];
  }
  st -> comp [];
  comp -> compEdit [label="«Редагувати»"];
  compEdit -> dv1 [label="«Зберегти»"];
  dv1 -> comp [constraint=false, label="так"];
  dv1 -> compEdit [constraint=false, label="ні: діагностика", style=dashed];
  comp -> cvac [label="меню «Вакансії»"];
  dv1 -> cvac [style=invis];
  cvac -> vForm [label="«Додати» /\n«Редагувати»"];
  vForm -> dv2 [label="«Зберегти»"];
  Vt [shape=circle, width=0.36, fixedsize=true, fontsize=11, label="В"];
  Vb [shape=circle, width=0.36, fixedsize=true, fontsize=11, label="В"];
  Vt -> cvac [];
  dv2 -> Vb [label="так"];
  dv2 -> vForm [constraint=false, label="ні: діагностика", style=dashed];
  cvac -> dDel [label="«Видалити»"];
  dDel -> Vb [label="так", arrowhead=normaltee, arrowsize=0.9];
  dDel -> Vb [label="ні", style=dashed];
  cvac -> cvac [label="«Закрити» / «Відкрити»"];
  cvac -> e2 [];
  Vb -> m1 [style=invis]; Vb -> apps [style=invis];
  cvac -> m1 [label="«Відповідні резюме»"];
  m1 -> dm [];
  dm -> mat [label="так"];
  Vb2 [shape=circle, width=0.36, fixedsize=true, fontsize=11, label="В"];
  dm -> Vb2 [label="ні: порожній стан,\nпорада переглянути вимоги", style=dashed];
  mat -> e3a [];
  cvac -> apps [label="«Кандидатури»"];
  apps -> dec [];
  dec -> apps [constraint=false, label="«Запросити»:\n«Запрошено»"];
  dec -> apps [constraint=false, label="«Відхилити»:\n«Відхилено»", arrowhead=normaltee, arrowsize=0.9];
  dec -> e3 [];
}