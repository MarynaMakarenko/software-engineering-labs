digraph uf_overview {
  graph [rankdir=TB, fontname="Arial", fontsize=12, nodesep=0.45, ranksep=0.5, pad=0.35, newrank=true, compound=true];
  node [fontname="Arial", fontsize=11, style=filled, fillcolor=white, color=black, penwidth=1.2];
  edge [fontname="Arial", fontsize=9.5, color="#222222", arrowsize=0.8];
  st [shape=ellipse, fillcolor="#dddddd", penwidth=1.4, fontsize=11, label="Початок: відвідувач\nвідкриває JobMatch"];
  home [shape=box, margin="0.08,0.04", class="page", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Головна</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">/</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">• пошук: посада, місто<BR/>• переходи до розділів</FONT></TD></TR></TABLE>>];
  vac [shape=box, margin="0.08,0.04", class="group", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Вакансії · Вакансія</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">/vacancies, /vacancies/{id}</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">• G1 перегляд і пошук<BR/>• C4 відгук (Шукач)</FONT></TD></TR></TABLE>>];
  help [shape=box, margin="0.08,0.04", class="page", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Допомога</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">/help</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">• U3 FAQ, Настанова PDF</FONT></TD></TR></TABLE>>];
  about [shape=box, margin="0.08,0.04", class="page", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Про агенцію й контакти</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">/about</FONT></TD></TR></TABLE>>];
  login [shape=box, margin="0.08,0.04", class="page", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Вхід</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">/login</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">• U1 email, пароль</FONT></TD></TR></TABLE>>];
  reg [shape=box, margin="0.08,0.04", class="page", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Реєстрація</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">/register</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">• G2 вибір ролі, дані</FONT></TD></TR></TABLE>>];
  auth [shape=box, class="process", margin="0.22,0.06", fillcolor="#f2f2f2", label="Перевірка email і пароля"];
  dauth [shape=diamond, fillcolor="#e9e9e9", fontsize=10, margin="0.02,0.02", label="Дані\nправильні?"];
  drole [shape=diamond, fillcolor="#e9e9e9", fontsize=10, margin="0.02,0.02", label="Роль?"];
  dreg [shape=diamond, fillcolor="#e9e9e9", fontsize=10, margin="0.02,0.02", label="Дані коректні,\nemail вільний?"];
  regp [shape=box, class="process", margin="0.22,0.06", fillcolor="#f2f2f2", label="Створення облікового запису"];
  cabC [shape=box, margin="0.08,0.04", class="group", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Кабінет шукача — рис. 3</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">/me/…  (8 сторінок)</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">• C1–C5, M1</FONT></TD></TR></TABLE>>];
  cabE [shape=box, margin="0.08,0.04", class="group", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Кабінет компанії — рис. 4</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">/company/…  (7 сторінок)</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">• E1–E4, M1</FONT></TD></TR></TABLE>>];
  cabR [shape=box, margin="0.08,0.04", class="group", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Кабінет рекрутера — рис. 5</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">/recruiter/…  (14 сторінок)</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">• R1–R7, M1</FONT></TD></TR></TABLE>>];
  cOut [shape=circle, width=0.36, fixedsize=true, fontsize=11, label="В"];
  logout [shape=box, class="process", margin="0.22,0.06", fillcolor="#f2f2f2", label="Завершення сесії (U2)"];
  fin [shape=ellipse, fillcolor="#dddddd", penwidth=2.6, fontsize=11, label="Результат: сесію завершено,\nГоловна «Ви вийшли із застосунку»"];
  cErr [shape=circle, width=0.36, fixedsize=true, fontsize=11, label="П"];
  err [shape=box, margin="0.08,0.04", class="page", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Помилка 404 / 500</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">будь-яка URL</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">• «На головну»</FONT></TD></TR></TABLE>>];
  st -> home [];
  home -> vac [label="«Вакансії»"];
  home -> help [label="«Допомога»"];
  help -> about [label="«Про агенцію»"];
  home -> login [label="«Увійти»"];
  home -> reg [label="«Реєстрація»"];
  vac -> login [label="відгук\nбез входу", style=dashed];
  login -> auth [label="«Увійти»"];
  auth -> dauth [];
  dauth -> login [label="ні: повідомлення", style=dashed];
  dauth -> drole [label="так"];
  drole -> cabC [label="Шукач"];
  drole -> cabE [label="Представник\nкомпанії"];
  drole -> cabR [label="Рекрутер"];
  reg -> dreg [label="«Зареєструватися»"];
  dreg -> reg [label="ні: діагностика", style=dashed];
  dreg -> regp [label="так"];
  regp -> login [label="«Реєстрацію\nзавершено»", arrowhead=normaltee, arrowsize=0.9];
  cabC -> cOut [];
  cabC -> cErr [style=dashed];
  cabE -> cOut [label="«Вийти»"];
  cabE -> cErr [label="id не знайдено /\nзбій", style=dashed];
  cabR -> cOut [];
  cabR -> cErr [style=dashed];
  cabC -> vac [label="«Вакансії»\nу шапці"];
  cOut -> logout [arrowhead=normaltee, arrowsize=0.9];
  logout -> fin [];
  cErr -> err [];
  Gt [shape=circle, width=0.36, fixedsize=true, fontsize=11, label="Г"];
  Gb [shape=circle, width=0.36, fixedsize=true, fontsize=11, label="Г"];
  Gt -> home [];
  err -> Gb [label="«На головну»"];
  {rank=same; cabC; cabE; cabR;}
}