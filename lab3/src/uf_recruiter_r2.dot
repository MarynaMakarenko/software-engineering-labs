digraph uf_recruiter_r2 {
  graph [rankdir=TB, fontname="Arial", fontsize=12, nodesep=0.35, ranksep=0.42, pad=0.35, newrank=true, compound=true];
  node [fontname="Arial", fontsize=11, style=filled, fillcolor=white, color=black, penwidth=1.2];
  edge [fontname="Arial", fontsize=9.5, color="#222222", arrowsize=0.8];
  st [shape=ellipse, fillcolor="#dddddd", penwidth=1.4, fontsize=11, label="Ціль: працевлаштувати кандидатів\nна вакансії клієнтів (після входу, рис. 1)"];
  panel [shape=box, margin="0.08,0.04", class="page", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Панель рекрутера</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">/recruiter</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">• відкриті вакансії: компанія, посада,<BR/>• зарплата, місто, кандидатури<BR/>• «Підібрати кандидатів»</FONT></TD></TR></TABLE>>];
  cc [shape=box, margin="0.08,0.04", class="page", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Картка компанії</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">/recruiter/companies/{id} (рис. 5б)</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">• «Підібрати кандидатів»</FONT></TD></TR></TABLE>>];
  subgraph cluster_t1 {
    label="Завдання: підібрати й запропонувати кандидатів (R2 — критичний; R4)"; labeljust=l; style="dashed,rounded"; color="#777777"; fontsize=11; fontname="Arial Bold"; margin=10;
    cP [shape=circle, width=0.36, fixedsize=true, fontsize=11, label="П"];
    dOpen [shape=diamond, fillcolor="#e9e9e9", fontsize=10, margin="0.02,0.02", label="Вакансія\nвідкрита?"];
    m1 [shape=box, class="process", margin="0.22,0.06", fillcolor="#f2f2f2", label="Оцінювання відповідності (M1)"];
    dEmp [shape=diamond, fillcolor="#e9e9e9", fontsize=10, margin="0.02,0.02", label="Є кандидати\n≥ порогу?"];
    match [shape=box, margin="0.08,0.04", class="page", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Підбір кандидатів</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">/recruiter/vacancies/{id}/matches</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">• параметри вакансії; «Мін. оцінка, %», «Оновити»<BR/>• ПІБ, посада, зарплата, освіта, стаж, оцінка<BR/>• «Запропонувати» / «Запропоновано: …»</FONT></TD></TR></TABLE>>];
    dThr [shape=diamond, fillcolor="#e9e9e9", fontsize=10, margin="0.02,0.02", label="Поріг — ціле\n0–100?"];
    person [shape=box, margin="0.08,0.04", class="page", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Картка людини</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">/recruiter/people/{id}</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">• особисті дані, освіта,<BR/>• історія роботи, стаж (R4)</FONT></TD></TR></TABLE>>];
    dConf [shape=diamond, fillcolor="#e9e9e9", fontsize=10, margin="0.02,0.02", label="Форма пропозиції:\nрішення?"];
    dCom [shape=diamond, fillcolor="#e9e9e9", fontsize=10, margin="0.02,0.02", label="Коментар ≤ 500,\nкандидатури\nще немає?"];
    apc [shape=box, class="process", margin="0.22,0.06", fillcolor="#f2f2f2", label="Створення кандидатури\n(«Нова», джерело «Рекрутер»)"];
    e1 [shape=ellipse, fillcolor="#dddddd", penwidth=2.6, fontsize=11, label="Результат: кандидатів\nзапропоновано компанії"];
    err [shape=box, margin="0.08,0.04", class="page", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Помилка 404</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">• «На панель»</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_t5 {
    label="Завдання: зареєструвати працевлаштування (R7)"; labeljust=l; style="dashed,rounded"; color="#777777"; fontsize=11; fontname="Arial Bold"; margin=10;
    apps [shape=box, margin="0.08,0.04", class="page", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>Кандидатури</B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="#555555">/recruiter/applications</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10">• вакансія, компанія, ПІБ, джерело, статус<BR/>• фільтр за статусом<BR/>• «Зареєструвати працевлаштування»</FONT></TD></TR></TABLE>>];
    dHire [shape=diamond, fillcolor="#e9e9e9", fontsize=10, margin="0.02,0.02", label="Форма: дата початку;\nпідтвердити?"];
    hire [shape=box, class="process", margin="0.22,0.06", fillcolor="#f2f2f2", label="Запис в історію роботи, закриття\nвакансії, статус людини «не шукає»"];
    e5 [shape=ellipse, fillcolor="#dddddd", penwidth=2.6, fontsize=11, label="Результат: «Працевлаштування\n<ПІБ> … зареєстровано»"];
  }
  st -> panel [];
  panel -> cP [label="«Підібрати\nкандидатів»"];
  cc -> cP [label="«Підібрати\nкандидатів»"];
  cP -> dOpen [];
  Nt [shape=circle, width=0.36, fixedsize=true, fontsize=11, label="Н"];
  Nb [shape=circle, width=0.36, fixedsize=true, fontsize=11, label="Н"];
  Nb2 [shape=circle, width=0.36, fixedsize=true, fontsize=11, label="Н"];
  Nt -> panel [];
  dOpen -> Nb [label="ні: «Вакансію закрито —\nпідбір недоступний» (A4)", style=dashed];
  dOpen -> m1 [label="так"];
  m1 -> dEmp [];
  dEmp -> match [label="так"];
  dEmp -> m1 [constraint=false, label="ні: «Показати часткові\nзбіги (від 25 %)» (A1)", style=dashed];
  match -> dThr [label="«Оновити» (A2)"];
  dThr -> m1 [constraint=false, label="так"];
  St [shape=circle, width=0.36, fixedsize=true, fontsize=11, label="С"];
  Sb [shape=circle, width=0.36, fixedsize=true, fontsize=11, label="С"];
  St -> match [];
  dThr -> Sb [label="ні: діагностика", style=dashed];
  match -> person [label="ПІБ (крок 4)"];
  person -> Sb [label="«Назад до підбору»"];
  match -> dConf [label="«Запропонувати»"];
  dConf -> Sb [label="«Скасувати» (A6)", style=dashed];
  dConf -> dCom [label="«Підтвердити»"];
  dCom -> Sb [label="ні: діагностика (A5) /\n«Кандидатура вже існує» (A3)", style=dashed];
  dCom -> apc [label="так"];
  apc -> Sb [label="повідомлення,\n«Запропоновано: Нова»", arrowhead=normaltee, arrowsize=0.9];
  match -> e1 [label="завершено (крок 8)"];
  match -> err [label="запис видалено (A7)", style=dashed];
  err -> Nb2 [label="«На панель»"];
  panel -> apps [label="меню «Кандидатури»"];
  apps -> dHire [label="«Зареєструвати\nпрацевлаштування»"];
  dHire -> apps [constraint=false, label="ні", style=dashed];
  dHire -> hire [label="так", arrowhead=normaltee, arrowsize=0.9];
  hire -> e5 [];
}